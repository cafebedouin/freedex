{
  "name": "freedex",
  "private": true,
  "type": "module",
  "description": "FreeDEX for Ergo: a self-hosted static DEX page (ErgoDEX v1 pool swaps, Machina limit orders and Babel bids, SigmaUSD bank, SigmaFi bonds, TokenJay escrow), built with Fleet in the browser, signed by your wallet",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "tokens": "node scripts/tokens.ts > src/tokenlist.json"
  },
  "dependencies": {
    "@fleet-sdk/ageusd-plugin": "^0.1.23",
    "@fleet-sdk/common": "0.10.0",
    "@fleet-sdk/core": "0.12.0",
    "@fleet-sdk/crypto": "0.11.0",
    "@fleet-sdk/serializer": "0.11.0",
    "@nautls/machinafi-sdk": "0.1.0",
    "ergo-lib-wasm-browser": "0.28.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fleet-sdk/compiler": "^0.12.0",
    "@fleet-sdk/mock-chain": "0.12.0",
    "@nautilus-js/eip12-types": "^0.1.11",
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "ergo-lib-wasm-nodejs": "0.28.0",
    "eslint": "10.13.0",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "happy-dom": "21.0.4",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.0.5"
  },
  "license": "CC0-1.0",
  "engines": {
    "node": ">=22.12"
  }
}
