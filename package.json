{
  "name": "freedex",
  "private": true,
  "type": "module",
  "description": "FreeDEX for Ergo: a self-hosted static DEX page (ErgoDEX v1 pool swaps and Machina limit orders), built with Fleet in the browser, signed by your wallet",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "tokens": "node scripts/tokens.ts > src/tokenlist.json"
  },
  "dependencies": {
    "@fleet-sdk/ageusd-plugin": "^0.1.23",
    "@fleet-sdk/common": "0.10.0",
    "@fleet-sdk/core": "0.12.0",
    "@fleet-sdk/crypto": "0.11.0",
    "@fleet-sdk/serializer": "0.11.0",
    "@nautls/machinafi-sdk": "0.1.0"
  },
  "devDependencies": {
    "@fleet-sdk/mock-chain": "0.12.0",
    "@nautilus-js/eip12-types": "^0.1.11",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "license": "CC0-1.0"
}
